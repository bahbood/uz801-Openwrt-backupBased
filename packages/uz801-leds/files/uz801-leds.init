#!/bin/sh /etc/rc.common

START=99
STOP=10

MONITOR="/usr/sbin/uz801-led-monitor"
PIDFILE="/var/run/uz801-led-monitor.pid"

start() {
	# Blue = Wi-Fi
	timeout=60
	while [ ! -e /sys/class/net/phy0-ap0 ] && [ "$timeout" -gt 0 ]; do
		sleep 1
		timeout=$((timeout - 1))
	done

	if [ -e /sys/class/net/phy0-ap0 ]; then
		echo none > /sys/class/leds/blue:wlan/trigger
		echo netdev > /sys/class/leds/blue:wlan/trigger
		echo phy0-ap0 > /sys/class/leds/blue:wlan/device_name
		echo 1 > /sys/class/leds/blue:wlan/link
		echo 0 > /sys/class/leds/blue:wlan/rx
		echo 0 > /sys/class/leds/blue:wlan/tx
	fi

	# Red = Power
	echo none > /sys/class/leds/red:power/trigger
	echo 1 > /sys/class/leds/red:power/brightness

	# Green = Internet/QMI
	echo none > /sys/class/leds/green:wan/trigger
	echo 0 > /sys/class/leds/green:wan/brightness

	# Prevent duplicate monitor
	if [ -f "$PIDFILE" ]; then
		PID="$(cat "$PIDFILE" 2>/dev/null)"
		if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
			return 0
		fi
		rm -f "$PIDFILE"
	fi

	"$MONITOR" >/dev/null 2>&1 &
	echo "$!" > "$PIDFILE"
}

stop() {
	if [ -f "$PIDFILE" ]; then
		PID="$(cat "$PIDFILE" 2>/dev/null)"
		[ -n "$PID" ] && kill "$PID" 2>/dev/null || true
		rm -f "$PIDFILE"
	fi

	# Green = off
	echo none > /sys/class/leds/green:wan/trigger
	echo 0 > /sys/class/leds/green:wan/brightness

	# Red = Power
	echo none > /sys/class/leds/red:power/trigger
	echo 1 > /sys/class/leds/red:power/brightness
}